# Documents generated for the current application
out/

# What the SessionEnd hook's unattended /notes run did, rewritten each run
.claude/session_end.last

# What the SessionEnd hook's daily git sweep did, rewritten each run
.claude/git_sweep.last

# Playwright MCP runtime files
.playwright-mcp/

# The session history: journal.sh writes it, and it stays on this machine
.claude/session_history.md

# The digests: each day's read and list (digest/<name>/), each run log and last send (.claude/digest/)
digest/
.claude/digest/

# Credentials secret_file.sh reads, such as gmail-app-password
.secrets/
